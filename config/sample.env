# Copy this file to .env in the project root and edit.
# Only set the values you want to override — unset keys use the script defaults.

# Device tag written to InfluxDB (must be unique per Pi)
DEVICE=RPi-1

# InfluxDB endpoints — JSON array of [host, port, database]
INFLUX_ENDPOINTS=[["10.239.99.73",8086,"AAB"],["10.239.99.97",8086,"AAB"]]

# Measurement cadence
AVG=5
PERIOD=60

# Auto-sensitivity switching
AUTORANGE_ENABLE=true
AUTORANGE_HYST=3
AUTORANGE_SAT_FRAC=0.875
AUTORANGE_LOW_FRAC=0.003

# CSV output: when true, write a CSV row every cycle regardless of InfluxDB
# success (useful for parallel local logging or field experiments where you
# want a guaranteed local record). When false (default), CSV is only written
# when ALL InfluxDB endpoints fail — i.e. true offline-buffer behaviour.
CSV_ALWAYS=false

# HI sensitivity preset (dim light — high gain, long integration)
SENS_HI_IT_MS=50
SENS_HI_GAIN=GAIN_256X

# LO sensitivity preset (bright light — low gain, short integration)
SENS_LO_IT_MS=10
SENS_LO_GAIN=GAIN_16X
